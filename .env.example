# ==========================================================
# PythonProject7 环境配置模板
# 复制为 .env 并填入真实值：copy .env.example .env
# 注意：重复的变量以最后一次出现为准（dotenv 后写覆盖先写）
# ==========================================================

# ---------- LLM（主对话模型，OpenAI 兼容接口） ----------
# 必填：至少配一个 provider 的 API Key
# LLM_PROVIDER：auto（推荐，按模型名 + 已配置的 Key 自动识别）
#   也可强制指定：deepseek / qwen / modelscope / kimi / zhipu / openai / ollama / vllm
LLM_PROVIDER=auto
# LLM_MODEL_ID：全局默认模型 id（不传 provider 时用它）
#   注意：模型名要和渠道匹配（deepseek-chat 配 DEEPSEEK_API_KEY；
#   qwen3.5:2b 这类 "model:tag" 写法走本地 ollama）
LLM_MODEL_ID=qwen3.5:2b
LLM_BASE_URL=            # 可选：全局默认 base_url（如本地 ollama http://localhost:11434/v1）
LLM_API_KEY=             # 可选：全局默认 api_key
LLM_TIMEOUT=60

# DeepSeek（https://platform.deepseek.com/）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 阿里 DashScope / qwen（https://dashscope.aliyun.com/）
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_BASE_URL=https://dashscope.aliyun.com/compatible-mode/v1

# ModelScope（https://modelscope.cn/）
MODELSCOPE_API_KEY=ms-xxx
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# 本地 ollama（可选，无需 key）
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL_ID=qwen3.5:2b



# ---------- 存储（可选，不配则相关功能自动降级） ----------
# Qdrant 向量库（RAG / 语义记忆需要；本地 docker run -p 6333:6333 qdrant/qdrant 即可）
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=memory_vectors
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=60

# Neo4j 图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# ---------- Embedding（按需检索/语义记忆用，失败自动降级） ----------
# 类型：dashscope / local / tfidf
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v3
EMBED_API_KEY=sk-xxx
EMBED_BASE_URL=https://dashscope.aliyun.com/compatible-mode/v1

# ---------- RAG retrieval ----------
# hybrid = dense + character-lexical + exact-identifier filtering
# legacy = original vector/MQE retrieval
RAG_RETRIEVER_MODE=hybrid
RAG_HYBRID_COLLECTION=rag_knowledge_base_local_minilm_384_v1
RAG_HYBRID_MIN_SCORE=0.30
# Optional override; by default the name includes model identity and dimension.
# EPISODIC_VECTOR_COLLECTION=episodic_vectors_paraphrase_multilingual_minilm_l12_v2_384_v1
# SEMANTIC_VECTOR_COLLECTION=semantic_vectors_paraphrase_multilingual_minilm_l12_v2_384_v1
# After the local model has been downloaded, these avoid unnecessary network probes.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# ---------- 物业催缴 RL（默认关闭，只提供人工审核建议） ----------
COLLECTION_RL_ENABLED=false
# 可选：共享策略文件路径；留空时使用 outputs/rl/collection_policy_v1.json
COLLECTION_RL_POLICY=
