# ==========================================================
# PythonProject7 环境配置模板
# 复制为 .env 并填入真实值：copy .env.example .env
# 注意：重复的变量以最后一次出现为准（dotenv 后写覆盖先写）
# ==========================================================

# ---------- LLM（主对话模型，OpenAI 兼容接口） ----------
# 必填：至少配一个 provider 的 API Key
# LLM_MODEL_ID：全局默认模型 id（不传 provider 时用它）
LLM_MODEL_ID=deepseek-chat
LLM_BASE_URL=            # 可选：全局默认 base_url（如本地 ollama http://localhost:11434/v1）
LLM_API_KEY=             # 可选：全局默认 api_key
LLM_TIMEOUT=60

# DeepSeek（https://platform.deepseek.com/）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 阿里 DashScope / qwen（https://dashscope.aliyun.com/）
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_BASE_URL=https://dashscope.aliyun.com/compatible-mode/v1

# ModelScope（https://modelscope.cn/）
MODELSCOPE_API_KEY=ms-xxx
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# 本地 ollama（可选，无需 key）
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL_ID=qwen3.5:2b

# ---------- 工具类 API（可选） ----------
# 搜索（serper.dev）
SEARCH_API=xxx
DEFAULT_SEARCH_BASE_URL=https://google.serper.dev/search
# 天气（qweather）
WEATER_API_KEY=xxx
WAETER_BASE_URL=https://xxx.re.qweatherapi.com/weather/v1/current/39.92/

# ---------- 存储（可选，不配则相关功能自动降级） ----------
# Qdrant 向量库（RAG / 语义记忆需要；本地 docker run -p 6333:6333 qdrant/qdrant 即可）
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=memory_vectors
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=60

# Neo4j 图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# ---------- Embedding（按需检索/语义记忆用，失败自动降级） ----------
# 类型：dashscope / local / tfidf
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v3
EMBED_API_KEY=sk-xxx
EMBED_BASE_URL=https://dashscope.aliyun.com/compatible-mode/v1
